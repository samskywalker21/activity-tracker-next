# PostgreSQL 18 (local install)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/activity_tracker"
TEST_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/activity_tracker_test"

# Better Auth — generate a secret with `openssl rand -base64 32`
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"

# All dates are stored as timestamptz and shown in this zone
APP_TIMEZONE="Asia/Manila"
